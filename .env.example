# ==============================================================================
# RetinaGuard - Environment Variables Template
# All personal health data strictly hosted in India data centers (DPDP Act 2023)
# ==============================================================================

# Application Environment (development | staging | production)
RETINAGUARD_ENV=development
RETINAGUARD_PORT=8000
RETINAGUARD_LOG_LEVEL=INFO

# Cloud Region & Data Residency (Strictly India: Mumbai / Delhi)
CLOUD_REGION=asia-south1

# PHI Field-Level Symmetric Encryption Key (Base64-encoded 32-byte AES-256 key)
# Generate via: python -c "from retinaguard.core.encryption import PHIEncryptor; print(PHIEncryptor.generate_key_b64())"
RETINAGUARD_PHI_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_aes_key==

# Database Configuration (PostgreSQL in India region)
DATABASE_URL=postgresql://retinaguard:retinaguard@localhost:5432/retinaguard_db

# Audit Ledger Secret (HMAC / Hash chain salt)
AUDIT_LEDGER_SECRET=replace_with_secure_random_salt_for_audit_hash_chain

# Optional LLM / RAG Explainer API Key (Used strictly for plain language synthesis, NEVER for diagnostic numbers)
GEMINI_API_KEY=

